@model List<FINAPSA.Models.Class>
@{
    ViewData["Title"] = "Manage Classes";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-0">Manage Classes</h4>
        <small class="text-muted">Assign teachers to each class</small>
    </div>
    <span class="badge bg-primary-subtle text-primary px-3 py-2 rounded-pill">
        @Model.Count class(es)
    </span>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-3" role="alert">
        <i class="fa fa-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show rounded-3" role="alert">
        <i class="fa fa-exclamation-circle me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (!Model.Any())
{
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body text-center py-5 text-muted">
            <i class="fa fa-chalkboard fa-2x mb-2 d-block opacity-25"></i>
            No classes found. Classes are seeded automatically on startup.
        </div>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var cls in Model)
        {
            var activeTeachers = cls.ClassTeachers?.Where(ct => ct.IsActive).ToList()
                                 ?? new List<FINAPSA.Models.ClassTeacher>();
            var studentCount   = cls.Students?.Count ?? 0;

            <div class="col-lg-6">
                <div class="card border-0 shadow-sm rounded-4 h-100">
                    <div class="card-body p-4">

                        
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div class="d-flex align-items-center gap-3">
                                <div style="width:42px;height:42px;border-radius:10px;
                                            background:#dbeafe;display:flex;align-items:center;
                                            justify-content:center;flex-shrink:0">
                                    <i class="fa fa-chalkboard text-primary"></i>
                                </div>
                                <div>
                                    <h6 class="fw-bold mb-0">@cls.ClassName</h6>
                                    @if (!string.IsNullOrEmpty(cls.Description))
                                    {
                                        <small class="text-muted">@cls.Description</small>
                                    }
                                </div>
                            </div>
                            <div class="text-end">
                                <span class="badge bg-primary-subtle text-primary d-block mb-1">
                                    <i class="fa fa-user-graduate me-1"></i>@studentCount student(s)
                                </span>
                                <span class="badge bg-success-subtle text-success">
                                    <i class="fa fa-chalkboard-teacher me-1"></i>@activeTeachers.Count teacher(s)
                                </span>
                            </div>
                        </div>

                         
                        @if (activeTeachers.Any())
                        {
                            <div class="mb-3">
                                <small class="text-muted fw-semibold d-block mb-2 text-uppercase"
                                       style="font-size:0.65rem;letter-spacing:0.8px">
                                    Assigned Teachers
                                </small>
                                @foreach (var ct in activeTeachers)
                                {
                                    <div class="d-flex justify-content-between align-items-center
                                                py-2 border-bottom">
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="sp-avatar sm"
                                                 style="background:#eff6ff;color:#1d4ed8;border:none;
                                                        font-size:0.72rem;flex-shrink:0">
                                                @(ct.Staff?.FullName?.Substring(0, 1).ToUpper() ?? "?")
                                            </div>
                                            <div>
                                                <div class="fw-semibold small">@ct.Staff?.FullName</div>
                                                @if (!string.IsNullOrEmpty(ct.Subject))
                                                {
                                                    <small class="text-muted">@ct.Subject</small>
                                                }
                                            </div>
                                        </div>
                                        <form asp-action="UnassignTeacher" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="classTeacherId" value="@ct.Id" />
                                            <input type="hidden" name="classId"        value="@cls.Id" />
                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger"
                                                    title="Remove teacher"
                                                    onclick="return confirm('Remove @ct.Staff?.FullName from this class?')">
                                                <i class="fa fa-times"></i>
                                            </button>
                                        </form>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="text-muted small py-2 mb-3">
                                <i class="fa fa-info-circle me-1"></i>No teachers assigned yet.
                            </div>
                        }

                         
                        <a asp-action="AssignTeacher" asp-route-classId="@cls.Id"
                           class="btn btn-outline-primary btn-sm w-100">
                            <i class="fa fa-user-plus me-1"></i> Assign Teacher
                        </a>

                    </div>
                </div>
            </div>
        }
    </div>
}
