@model FINAPSA.Models.Class
@{
    ViewData["Title"] = "Create Class";
}

<div class="d-flex align-items-center gap-2 mb-4">
    <a asp-action="ManageClasses" class="btn btn-outline-secondary btn-sm">
        <i class="fa fa-arrow-left"></i>
    </a>
    <div>
        <h4 class="fw-bold mb-0">Create New Class</h4>
        <small class="text-muted">Add a new class to the system</small>
    </div>
</div>

<div class="row">
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4">
                <form asp-action="CreateClass" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <div class="mb-3">
                        <label asp-for="ClassName" class="form-label">Class Name <span class="text-danger">*</span></label>
                        <input asp-for="ClassName" class="form-control" placeholder="e.g., Form 1A, JSS 2" />
                        <span asp-validation-for="ClassName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label">Description</label>
                        <textarea asp-for="Description" class="form-control" rows="3" placeholder="Optional description..."></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="fa fa-save me-2"></i>Create Class
                        </button>
                        <a asp-action="ManageClasses" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

