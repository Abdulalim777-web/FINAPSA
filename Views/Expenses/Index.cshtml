@model IEnumerable<FINAPSA.Models.ViewModels.ExpenseIndexItem>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<div class="mb-4">
    <a asp-action="Create" class="btn btn-primary btn-lg">
        <i class="fas fa-plus"></i> Create New Expense
    </a>
</div>

<div class="container my-5">
    <div class="dashboard-wrapper bg-white rounded-4 shadow-sm p-4">

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Category)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Amount)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Date)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Note)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ReceiptPath)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Category)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Amount)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Date)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Note)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ReceiptPath)
            </td>
            <td>
                @if (!item.IsSalary)
                {
                    <a asp-action="Edit" asp-route-id="@item.ExpenseId" class="btn btn-warning btn-sm">
                        <i class="fas fa-edit"></i> Edit
                    </a>
                    <a asp-action="Details" asp-route-id="@item.ExpenseId" class="btn btn-info btn-sm">
                        <i class="fas fa-eye"></i> Details
                    </a>
                    <a asp-action="Delete" asp-route-id="@item.ExpenseId" class="btn btn-danger btn-sm">
                        <i class="fas fa-trash"></i> Delete
                    </a>
                }
                else
                {
                    <span class="text-muted">Salary record</span>
                }
            </td>
        </tr>
}
    </tbody>
</table>

</div>
</div>